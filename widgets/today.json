{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${label}", "size": "Small", "isSubtle": true, "spacing": "None" },
            { "type": "TextBlock", "text": "${date}", "size": "Large", "weight": "Bolder", "spacing": "None", "wrap": false }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Bottom",
          "items": [
            { "type": "TextBlock", "$when": "${hasHol}", "text": "${hol}", "size": "Small", "color": "Attention", "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${items}",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "60px",
              "items": [
                { "type": "TextBlock", "text": "${time}", "size": "Small", "weight": "Bolder", "color": "Accent", "spacing": "None" },
                { "type": "TextBlock", "text": "${end}", "size": "Small", "isSubtle": true, "spacing": "None" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "wrap": false, "spacing": "None" },
                { "type": "TextBlock", "$when": "${sub != ''}", "text": "${sub}", "size": "Small", "isSubtle": true, "wrap": false, "spacing": "None" }
              ]
            }
          ]
        },
        { "type": "TextBlock", "$when": "${empty}", "text": "${emptyText}", "isSubtle": true, "wrap": true },
        { "type": "TextBlock", "$when": "${hasMore}", "text": "ほか ${more} 件", "size": "Small", "isSubtle": true, "spacing": "Small" }
      ]
    },
    { "type": "TextBlock", "text": "${updated}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Right", "spacing": "Small" }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "予定を追加", "verb": "add" },
    { "type": "Action.Execute", "title": "カレンダーを開く", "verb": "open" }
  ]
}
